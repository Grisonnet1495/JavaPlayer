<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.javaPlayer.project.view.GUI.JFrameAccountChooser">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="3" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <hspacer id="f9b43">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
      <hspacer id="226f">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
      <grid id="f01cc" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="4c6c" binding="contentPanel" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="10" bottom="0" right="10"/>
            <constraints/>
            <properties/>
            <border type="none"/>
            <children>
              <component id="2099b" class="javax.swing.JButton" binding="guestUserButton">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="2" fill="0" indent="0" use-parent-layout="false">
                    <minimum-size width="50" height="50"/>
                    <preferred-size width="50" height="50"/>
                    <maximum-size width="50" height="50"/>
                  </grid>
                </constraints>
                <properties>
                  <text value="U"/>
                </properties>
              </component>
              <component id="6acd8" class="javax.swing.JLabel" binding="guestUserLabel">
                <constraints>
                  <grid row="1" column="0" row-span="2" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Guest User"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="76416" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="10" bottom="0" right="10"/>
            <constraints/>
            <properties/>
            <border type="none"/>
            <children>
              <component id="506a" class="javax.swing.JButton" binding="createAccountButton">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="2" fill="0" indent="0" use-parent-layout="false">
                    <minimum-size width="50" height="50"/>
                    <preferred-size width="50" height="50"/>
                    <maximum-size width="50" height="50"/>
                  </grid>
                </constraints>
                <properties>
                  <font size="20"/>
                  <text value="+"/>
                </properties>
              </component>
              <component id="6c36d" class="javax.swing.JLabel" binding="createAccountLabel">
